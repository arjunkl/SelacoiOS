# GZSelaco does not encode a ZMusic revision. This is an explicit compatibility
# trial pin, not a claim that upstream designated it as the canonical version.
ZMUSIC_REPOSITORY=https://github.com/ZDoom/ZMusic.git
ZMUSIC_COMMIT=d3b730795784bff3f97571446101c57c1c6ac9bc
ZMUSIC_PROJECT_VERSION=1.3.0

# GZSelaco's pinned vcpkg baseline resolves libvpx to 1.12.0 port-version 2.
# The exact upstream v1.12.0 tag commit is pinned here for the iOS probe.
LIBVPX_REPOSITORY=https://github.com/webmproject/libvpx.git
LIBVPX_COMMIT=03265cd42b3783532de72f2ded5436652e6f5ce3
LIBVPX_VERSION=1.12.0
LIBVPX_VCPKG_PORT_VERSION=2
